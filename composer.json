{
  "name": "friends-of-contao/contao-associategroups",
  "description": "Creates association tables for member groups and user groups.",
  "license": "LGPL-3.0-or-later",
  "type": "contao-bundle",
  "keywords": [
    "contao",
    "associate",
    "member group",
    "user group"
  ],
  "authors": [
    {
      "name": "terminal42 gmbh",
      "homepage": "http://terminal42.ch"
    },
    {
      "name": "Oliver Hoff",
      "email": "oliver@hofff.com",
      "homepage": "https://www.hofff.com",
      "role": "Developer"
    },
    {
      "name": "David Molineus",
      "email": "david.molineus@netzmacht.de",
      "homepage": "http://netzmacht.de",
      "role": "Developer"
    },
    {
      "name": "Cliff Parnitzky",
      "email": "contao@cliff-parnitzky.de",
      "homepage": "https://contao.cliff-parnitzky.de",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/friends-of-contao/contao-associategroups/issues",
    "irc": "irc://irc.freenode.org/contao.dev",
    "source": "https://github.com/friends-of-contao/contao-associategroups"
  },
  "require": {
    "php": "^8.3",
    "contao/core-bundle": "^5.3",
    "doctrine/dbal": "^3.9 || ^4.9",
    "symfony/http-foundation": "^6.4 || ^7.0",
    "symfony/http-kernel": "^6.4 || ^7.0",
    "symfony/routing": "^6.4 || ^7.0",
    "symfony/security-bundle": "^6.4 || ^7.0",
    "symfony/translation-contracts": "^3.0"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.1",
    "phpcq/runner-bootstrap": "@dev"
  },
  "replace": {
    "contao-legacy/associategroups": "*"
  },
  "conflict": {
    "contao/manager-plugin": "<2.1 || >= 3.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "FriendsOfContao\\AssociateGroups\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "contao-community-alliance/composer-plugin": true,
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true
    },
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.3.x-dev",
      "dev-develop": "2.0.x-dev"
    },
    "contao-manager-plugin": "FriendsOfContao\\AssociateGroups\\ContaoManager\\Plugin"
  }
}
